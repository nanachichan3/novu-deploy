# Copy to .env and fill in values for local dev
# For production, env vars are set in Coolify

# Secrets — MUST be set
JWT_SECRET=your-jwt-secret-min-32-chars
STORE_ENCRYPTION_KEY=your-32-char-encryption-key
NOVU_SECRET_KEY=your-random-secret-key

# MongoDB
MONGO_INITDB_ROOT_USERNAME=novu
MONGO_INITDB_ROOT_PASSWORD=your-mongo-password
MONGO_URL=mongodb://novu:your-mongo-password@mongodb:27017/novu-db?authSource=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_INDEX=2

# General
NODE_ENV=production
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_AUTO_CREATE_INDEXES=true

# S3 (local stack - leave empty for filesystem)
S3_LOCAL_STACK=false
S3_BUCKET_NAME=novu-db
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URLs (set to your domain on Coolify)
API_ROOT_URL=http://novu-api.your-domain.com:3000
FRONT_BASE_URL=http://novu.your-domain.com:4000
VITE_API_HOSTNAME=http://novu-api.your-domain.com:3000
VITE_WEBSOCKET_HOSTNAME=http://novu-api.your-domain.com:3002
VITE_LEGACY_DASHBOARD_URL=http://novu.your-domain.com:4000

# Ports
API_PORT=3000
WS_PORT=3002

# Feature flags
IS_API_IDEMPOTENCY_ENABLED=false
IS_API_RATE_LIMITING_ENABLED=false
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
IS_V2_ENABLED=true
IS_SELF_HOSTED=true
IS_EMAIL_INLINE_CSS_DISABLED=false
IS_USE_MERGED_DIGEST_ID_ENABLED=false

# JWT
SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15d

# Observability
SENTRY_DSN=
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=novu
NEW_RELIC_LICENSE_KEY=

# Queue tuning
BROADCAST_QUEUE_CHUNK_SIZE=100
MULTICAST_QUEUE_CHUNK_SIZE=100
